rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin: sửa email cho khớp tên đăng nhập admin trong js/config.js (tendangnhap@vlyn.game)
    function isAdmin() {
      return request.auth != null && request.auth.token.email in ['qthi@vlyn.game'];
    }

    // Mỗi người chỉ đọc/ghi nhân vật của mình. Admin được xem tất cả.
    match /players/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
