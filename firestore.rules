rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin: sửa email cho khớp tên đăng nhập admin trong js/config.js (tendangnhap@vlyn.game)
    function isAdmin() {
      return request.auth != null && request.auth.token.email in ['qthi@vlyn.game'];
    }

    // Mỗi người chỉ đọc/ghi nhân vật của mình. Admin được xem tất cả.
    match /players/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Chợ: ai đăng nhập cũng xem được; chỉ rao hàng đứng tên mình; xóa khi rút về hoặc khi có người mua
    match /market/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null;
    }

    // Vàng chờ người bán nhận: người mua ghi vào, chỉ người bán đọc và xóa
    match /payouts/{uid}/list/{pid} {
      allow create: if request.auth != null;
      allow read, delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
